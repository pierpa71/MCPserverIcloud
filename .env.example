# ============================================================
#  iCloud Mail MCP — configurazione
#  Copia questo file in .env e compila i valori.
# ============================================================

# --- Account iCloud --------------------------------------------------------
# Indirizzo completo (es. nome@icloud.com / @me.com / @mac.com)
ICLOUD_EMAIL=nome@icloud.com
# Password specifica per app (appleid.apple.com > Accesso e sicurezza >
# Password specifiche per le app). NON la password dell'Apple ID.
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Mittente mostrato nelle mail (facoltativi). FROM_ADDRESS può essere un alias iCloud.
ICLOUD_FROM_NAME=
ICLOUD_FROM_ADDRESS=

# --- Permessi -----------------------------------------------------------------
# true = solo lettura (niente bozze, spostamenti, flag, invio)
ICLOUD_READ_ONLY=false
# true = abilita il tool send_email (invio immediato). Di default solo bozze.
ICLOUD_ALLOW_SEND=false
# Salva una copia dei messaggi inviati in "Sent Messages".
# Se vedi i messaggi inviati duplicati, metti false.
ICLOUD_SAVE_SENT=true

# --- Sicurezza endpoint HTTP -----------------------------------------------------
# Almeno uno dei due è obbligatorio. Genera valori casuali con:  openssl rand -hex 32
#
# PATH_SECRET: l'endpoint diventa https://tuo-host/<PATH_SECRET>/mcp
#   -> è il metodo da usare per i connettori personalizzati di claude.ai
MCP_PATH_SECRET=
# BEARER_TOKEN: richiede l'header "Authorization: Bearer <token>"
#   -> utile per client che permettono header (Claude Code, Claude Desktop, mcp-remote)
MCP_BEARER_TOKEN=

# --- Avanzate (di solito non serve toccarle) -------------------------------------
# MCP_PORT=8000
# LOG_LEVEL=INFO
# ICLOUD_MAX_BODY_CHARS=30000
# ICLOUD_MAX_ATTACHMENT_BYTES=8388608
# ICLOUD_DRAFTS_FOLDER=Drafts
# ICLOUD_SENT_FOLDER=Sent Messages
# ICLOUD_TRASH_FOLDER=Deleted Messages

# --- Cloudflare Tunnel (solo se usi il profilo "tunnel" del compose) --------------
CLOUDFLARE_TUNNEL_TOKEN=
